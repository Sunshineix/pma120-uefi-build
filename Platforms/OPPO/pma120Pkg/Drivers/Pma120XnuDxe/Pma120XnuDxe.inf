[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Pma120XnuDxe
  FILE_GUID                      = 7A2B4C6D-8E0F-4A1B-9C2D-3E4F5A6B7C8D
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Pma120XnuDxeEntry

[Sources]
  Pma120XnuDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DebugLib
  UefiLib
  BaseMemoryLib
  CacheMaintenanceLib

[Depex]
  TRUE
