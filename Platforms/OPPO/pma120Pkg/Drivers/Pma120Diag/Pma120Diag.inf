#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Pma120Diag
  FILE_GUID                      = E08F4E41-1E40-47FD-BF78-5E5E84128B1A
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Pma120DiagEntry

[Sources]
  Pma120Diag.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  DebugLib
  PrintLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid

[Depex]
  gEfiGraphicsOutputProtocolGuid
